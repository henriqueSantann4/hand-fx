{
  "name": "hand-fx",
  "version": "0.1.0",
  "description": "Esqueleto de app com rastreamento de duas mãos e sistema de efeitos modulares",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/setup-assets.mjs",
    "setup-assets": "node scripts/setup-assets.mjs"
  },
  "build": {
    "appId": "com.example.handfx",
    "productName": "HandFX",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "lil-gui": "^0.19.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
